{
  "manifest_version": 3,
  "name": "Page2Design",
  "version": "1.0.0",
  "description": "Scan a webpage and export an agent-ready design reference package. All processing stays on this device.",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "sidePanel"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Page2Design — Scan this page",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["sidepanel.html", "assets/*", "icons/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
