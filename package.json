{
  "name": "page2design",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Kazi Rahamatullah",
  "description": "Local-only Chrome extension that scans a webpage and exports an agent-ready design reference package.",
  "homepage": "https://github.com/rahmat058/page-2-design#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahmat058/page-2-design.git"
  },
  "bugs": {
    "url": "https://github.com/rahmat058/page-2-design/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "commit": "cz",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": "^1.33.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^9.34.0",
    "@types/chrome": "^0.1.4",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "commitizen": "^4.3.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "inquirer": "^9.3.8",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "lodash-es": "^4.18.1",
    "prettier": "^3.6.2",
    "prettier-plugin-css-order": "^2.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "config": {
    "commitizen": {
      "path": "./scripts/cz-commitlint-emoji.mjs"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
